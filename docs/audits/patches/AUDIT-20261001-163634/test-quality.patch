# Patch proposte dall'agente "test-quality" — deep adversarial audit Verba (AUDIT-20261001-163634)
# Proposte, MAI applicate. test-quality-1 = HIGH, -2/-3 = LOW, -4 (zero test) = INFO → nessuna patch (azione: introdurre suite, vedi report).

--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -134,7 +134,9 @@ jobs:
   publish-release:
     needs: build
+    # The documented dry-run guarantee (finding test-quality-1, HIGH):
+    # without this guard a workflow_dispatch run published the draft too,
+    # because github.ref_name on a branch is the branch name.
+    if: startsWith(github.ref, 'refs/tags/')
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
 
-      - name: Publish the draft release
-        run: gh release edit "${{ github.ref_name }}" --draft=false
+      - name: Verify the release is complete, then publish
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          TAG="${GITHUB_REF_NAME}"
+          ASSETS=$(gh release view "$TAG" --json assets -q '.assets[].name')
+          echo "$ASSETS" | grep -q "latest.json" || { echo "::error::updater manifest latest.json missing"; exit 1; }
+          echo "$ASSETS" | grep -qE '\.sig$' || { echo "::error::no signed (.sig) updater artifacts attached"; exit 1; }
+          gh release edit "$TAG" --draft=false

--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -22,9 +22,10 @@ jobs:
       - uses: actions/setup-python@v5
         with:
           python-version: "3.12"
           cache: pip
 
       - name: Install backend + tooling
-        run: pip install -e . ruff pyinstaller
+        # Pinned toolchain (finding test-quality-3): same versions as the
+        # desktop job and the release, so the lint/build verdict is stable.
+        run: pip install -e . -c constraints.txt ruff pyinstaller
 
       - name: Lint
         run: ruff check src

--- a/constraints.txt (nuovo file, condiviso con il finding dependency "no lockfile")
+++ b/constraints.txt
+# Tested versions at the time of release v0.1.1 (refresh with `uv pip freeze`
+# after intentional upgrades; see audit finding test-quality-3 / dependency-2).
