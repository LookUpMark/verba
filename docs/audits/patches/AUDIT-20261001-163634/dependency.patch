# Patch proposte dall'agente "dependency" — deep adversarial audit Verba (AUDIT-20261001-163634)
# Proposte, MAI applicate. CSP e lockfile = MEDIUM, licenza = LOW.
# tauri-plugin-updater mancante (MEDIUM): NESSUNA PATCH — decisione di prodotto
# già presa dal proprietario (firma/config ora, plugin runtime in v0.2); vedi report.
# Cargo.lock assente (MEDIUM): azione meccanica, non rappresentabile in patch —
# `cargo generate-lockfile` in desktop/src-tauri e commit del Cargo.lock.

--- a/src/verba/main.py
+++ b/src/verba/main.py
@@ (dopo il middleware local_only, nuovo middleware headers)
+@app.middleware("http")
+async def security_headers(request: Request, call_next):
+    """CSP and content-type hardening (finding dependency-1, MEDIUM).

+    The webview loads the UI from this HTTP sidecar and Tauri's CSP is null,
+    so this header is the only browser-side mitigation. Inline script/style
+    stays allowed because the UI is one inline file; the point is blocking
+    any exfiltration channel (connect-src 'self') and plugin/base-uri abuse.
+    """
+    response = await call_next(request)
+    response.headers["Content-Security-Policy"] = (
+        "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
+        "connect-src 'self'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
+    )
+    response.headers["X-Content-Type-Options"] = "nosniff"
+    return response

