+_CLIENTS: dict[str, httpx.AsyncClient] = {}
+
+
+def _shared_client(base_url: str) -> httpx.AsyncClient:
+    """One pooled client per endpoint (finding perf-3): a fresh client per
+    complete() call pays TCP setup on every tutor turn on the hot path."""
+    client = _CLIENTS.get(base_url)
+    if client is None:
+        client = httpx.AsyncClient(timeout=httpx.Timeout(connect=5.0, read=120.0, write=30.0, pool=10.0))
+        _CLIENTS[base_url] = client
+    return client
+
+
+async def close_clients() -> None:
+    """Called from the app lifespan on shutdown."""
+    for c in _CLIENTS.values():
+        with contextlib.suppress(Exception):
+            await c.aclose()
+    _CLIENTS.clear()
